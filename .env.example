# MuxTrail local configuration. Copy to .env; never commit the real file.

# Model providers: configure at least one for real model responses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# Primary structured web search.
TAVILY_API_KEY=

# Optional explicit fallback search provider.
BOCHA_API_KEY=

# Local runtime.
MUXTRAIL_STATE_DIR=.muxtrail-state
MUXTRAIL_CONFIG_PATH=
# Comma-separated exact browser origins allowed to call REST and WebSocket endpoints.
MUXTRAIL_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Restricted public demo. Keep disabled until /demo/ws is placed behind a
# dedicated public hostname or a path-specific Cloudflare Access bypass.
MUXTRAIL_DEMO_ENABLED=false
MUXTRAIL_DEMO_PUBLIC_HOST=demo-api.muxtrail.com
MUXTRAIL_DEMO_MAX_MESSAGE_CHARS=1000
MUXTRAIL_DEMO_MAX_TURNS=5
MUXTRAIL_DEMO_MESSAGES_PER_HOUR=10
MUXTRAIL_DEMO_DAILY_MESSAGE_LIMIT=100
MUXTRAIL_DEMO_MAX_CONCURRENT=2
MUXTRAIL_DEMO_TIMEOUT_SECONDS=60

# Slack Socket Mode (optional; disabled by default).
MUXTRAIL_SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Discord Gateway (optional; disabled by default).
MUXTRAIL_DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# Optional privileged intent workaround; also enable Message Content Intent in Discord's portal.
MUXTRAIL_DISCORD_MESSAGE_CONTENT_ENABLED=false

# Feishu long connection (optional; disabled by default).
MUXTRAIL_FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
MUXTRAIL_FEISHU_INTERNAL_SECRET=
MUXTRAIL_FEISHU_DOCS_WRITE_ENABLED=false
FEISHU_DOCS_BASE_URL=
